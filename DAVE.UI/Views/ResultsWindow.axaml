<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DAVE.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DAVE.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DAVE.Views.ResultsWindow"
        x:DataType="vm:ResultsWindowViewModel"
        Width="800"
        Height="450"
        MinWidth="700"
        MinHeight="400"
        Title="Results - D.A.V.E. Data Assurance + Verification Engine">

    <Design.DataContext>
        <vm:ResultsWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:BoolToEmojiConverter x:Key="BoolToEmojiConverter"/>
    </Window.Resources>

    <DockPanel>
        <Grid
            ColumnDefinitions="*,*"
            RowDefinitions="*"
            DockPanel.Dock="Bottom">
            <TextBlock
                Grid.Column="0"
                Text="{Binding ResultsStats}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="17"
                Padding="25 0 0 0" />
            <Grid Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="*">
                <Button
                    Grid.Column="0"
                    Click="OnCloseClicked"
                    IsCancel="True"
                    Padding="10"
                    Margin="20 10"
                    HorizontalAlignment="Right">
                    Close
                </Button>
                <Button
                    Grid.Column="1"
                    Command="{Binding OnEmailClicked}"
                    IsEnabled="{Binding IsEmailEnabled}"
                    IsDefault="True"
                    Padding="10"
                    Margin="20 10"
                    HorizontalAlignment="Right">
                    📧 Email Queries
                </Button>
            </Grid>
        </Grid>

        <DataGrid Margin="15 15 15 0"
                  ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderThickness="1" BorderBrush="Gray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" />
                <DataGridTextColumn Header="✅" Binding="{Binding Pass, Converter={StaticResource BoolToEmojiConverter}}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*" />
                <DataGridTextColumn Header="Previous" Binding="{Binding Previous}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
